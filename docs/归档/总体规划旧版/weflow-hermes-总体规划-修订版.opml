<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>WeFlow × Hermes 总体规划（修订版）</title>
  </head>
  <body>
    <outline text="〇、定位与分层（新）">
      <outline text="五层架构">
        <outline text="⑤ AI / Hermes：理解、决策、生成、调用工具">
        </outline>
        <outline text="④ Governance：RBAC / ACL / Audit / Approval">
        </outline>
        <outline text="③ Business Fact：Customer / Lead / Owner / Stage / Deal / Quote / After-sale">
        </outline>
        <outline text="② Knowledge：WeKnora / Published / Staging">
        </outline>
        <outline text="① Data Source：WeFlow / 微信聊天 / 本地数据库">
        </outline>
      </outline>
      <outline text="各层角色定位">
        <outline text="微信聊天：数据源，不是企业共享数据库">
        </outline>
        <outline text="WeFlow：个人工作台，不是多人数据库">
        </outline>
        <outline text="PostgreSQL：企业事实层">
        </outline>
        <outline text="WeKnora：企业知识服务，不承担 CRM 主数据职责">
        </outline>
        <outline text="Hermes：行动 Agent，不直接操作数据库">
        </outline>
        <outline text="Governance：所有 Agent 与人工操作的闸门">
        </outline>
      </outline>
      <outline text="多人协作核心原则">
        <outline text="口诀：个人数据本地化、企业事实集中化、聊天原文不共享、业务事实可同步、企业归属集中管理">
        </outline>
        <outline text="WeFlow = 个人工作副本（原始聊天 + 个人工作状态）">
        </outline>
        <outline text="NAS PostgreSQL = 企业共享事实源（客户 / 归属 / 成交 / 报价）">
        </outline>
        <outline text="WeKnora = 企业知识服务，不承担 CRM 主数据">
        </outline>
        <outline text="Hermes 写操作必须走 Tool Gateway + RBAC + ACL + Risk Policy">
        </outline>
        <outline text="高风险操作必须审批">
        </outline>
        <outline text="客户 owner 只有企业层可最终确认">
        </outline>
        <outline text="AI 只能提议，不能成为最终事实来源">
        </outline>
        <outline text="跨设备变化走事件同步，不同步数据库文件">
        </outline>
        <outline text="企业事实必备 source / updated_by / updated_at / version / audit">
        </outline>
        <outline text="Backup 是 Sync 的技术基础，但 Backup ≠ Sync">
        </outline>
      </outline>
    </outline>
    <outline text="一、现有能力（28 项已上线，不变）">
      <outline text="数据底座">
        <outline text="微信聊天解密存档（WCDB 只读）">
        </outline>
        <outline text="防撤回 + 群聊分析">
        </outline>
        <outline text="消息 / 联系人 / 朋友圈导出">
        </outline>
        <outline text="本地 HTTP API（5031）+ SSE 推送">
        </outline>
        <outline text="AI 调用收口（aiApiClient · DeepSeek）">
        </outline>
        <outline text="语音转写 + 中文分词">
        </outline>
        <outline text="年度报告">
        </outline>
      </outline>
      <outline text="获客与线索">
        <outline text="线索池（群扫描入池 / 归属移交）">
        </outline>
        <outline text="首触 SLA 24h（超期出卡）">
        </outline>
      </outline>
      <outline text="跟进与转化（成交前）">
        <outline text="客户 360 + 阶段分类（新客→了解→比价→决策→成交/流失）">
        </outline>
        <outline text="意向评分 + 风险预警">
        </outline>
        <outline text="今日行动引擎 R0–R8（规则出卡 + AI 分析预热）">
        </outline>
        <outline text="AI 回复建议 / 话术提炼">
        </outline>
        <outline text="承诺提取待办（到期 AI 核验）">
        </outline>
        <outline text="客户洞察画像（12 字段 + 证据溯源）">
        </outline>
      </outline>
      <outline text="成交与交付">
        <outline text="跟单中心 · 款项认领">
        </outline>
        <outline text="跟单中心 · 物流认领">
        </outline>
        <outline text="R8 签收超期提醒（24h）">
        </outline>
      </outline>
      <outline text="售后与复购">
        <outline text="现状空白 → Phase 1 补齐">
        </outline>
      </outline>
      <outline text="知识与 AI">
        <outline text="知识库关键词版（产品参数 / 话术 / FAQ）">
        </outline>
        <outline text="AI 话术提炼入库">
        </outline>
      </outline>
      <outline text="管理与团队">
        <outline text="销售漏斗">
        </outline>
        <outline text="周复盘报表">
        </outline>
        <outline text="逾期任务统计">
        </outline>
        <outline text="销售团队名单">
        </outline>
      </outline>
      <outline text="架构">
        <outline text="单机双库（销售库 + CRM 库，按微信号分库）">
        </outline>
        <outline text="Electron 主进程即后端（重活走 worker）">
        </outline>
        <outline text="文档生成（报价 / 报表）">
        </outline>
      </outline>
    </outline>
    <outline text="二、Phase 0 · 数据基线（新，插队 1~2 周）">
      <outline text="目的：历史遗留问题收口，这是整个项目的地基">
      </outline>
      <outline text="Customer 唯一身份：手机号 → customer_identity">
      </outline>
      <outline text="Stage 唯一事实源：account.sales_stage；其余阶段表达降级为 proposal / history / signal">
      </outline>
      <outline text="Owner 唯一事实源：单机期本地直改，预留 Phase 3 切换为「企业层确认」">
      </outline>
      <outline text="Evidence 统一格式：所有证据链同一结构（message_key / 摘要 / 时间）">
      </outline>
      <outline text="AI / Human 分离：AI 可写字段加 source / status（仅 stage、customer_type、intent_score；owner 永远不允许 AI 写）">
      </outline>
      <outline text="Timeline 统一：客户时间线单一来源，事件按 source 标注">
      </outline>
    </outline>
    <outline text="三、Phase 1 · 单机可靠性（原「迭代一 · 守护与补断崖」，约 2 周）">
      <outline text="原则">
        <outline text="纯规则与字段，零 AI 风险">
        </outline>
      </outline>
      <outline text="原迭代一内容（保留）">
        <outline text="NAS 自动备份（最高优先，堵裸奔）">
        </outline>
        <outline text="customer_profile 加 owner + 离职客户移交">
        </outline>
        <outline text="客户类型字段（dealer 经销商 / end_user 终端）">
        </outline>
        <outline text="售后生命周期（成交→已交付→待回访→复购/老客）">
        </outline>
        <outline text="R9 经销商拿货提醒（签收后第 10 天预警，15 天 deadline）">
        </outline>
        <outline text="R10 定期回访（成交后 15 / 30 / 90 天）">
        </outline>
        <outline text="R11 阶段停滞卡（比价&gt;14 天 / 决策&gt;21 天）">
        </outline>
        <outline text="成交登记结构化（成交额 / 型号 / 数量 / 交期）">
        </outline>
        <outline text="报价版本管理（版本 / 生效期 / 证据链）">
        </outline>
      </outline>
      <outline text="local_outbox 事件队列（新）">
        <outline text="做法：备份的同时写 outbox（backup + outbox）">
        </outline>
        <outline text="字段：event_id / entity_type / entity_id / operation / payload / created_at / sync_status / retry_count">
        </outline>
        <outline text="定位：本阶段只记录不发送；Phase 3 直接演进为同步队列">
        </outline>
        <outline text="原因：Backup ≠ Sync，现在补事件结构，避免 Phase 3 返工">
        </outline>
      </outline>
      <outline text="客户资源分配（原「新需求 · 功能一」，纯本地）">
        <outline text="录入：分配人员角色（主管 / 销售助理），批量导入 Excel / 粘贴清单">
        </outline>
        <outline text="查重：对已有客户手机号自动去重">
        </outline>
        <outline text="分配引擎三模式：比例权重（可调，默认）/ 轮询 / 按负载均衡">
        </outline>
        <outline text="生命周期：待分配池 → 已分配 → 认领（接首触 SLA 24h）→ 超时回收再分配">
        </outline>
        <outline text="审计留痕：录入人 / 分配对象 / 认领时间 / 回收记录">
        </outline>
        <outline text="数据模型升级（新）：lead → dedup → customer_identity → allocation → assignment → claim → owner">
          <outline text="建表：lead / customer / customer_identity / assignment / ownership_history">
          </outline>
          <outline text="原因：lead ≠ customer，同客户多来源线索要归并到一个身份">
          </outline>
          <outline text="原 lead 表 owner_id / pool_id / assigned_at 预留字段照常启用">
          </outline>
        </outline>
        <outline text="归属移交（改）：单机期本地直改；Phase 3 起切换为「申请移交 → 主管批准 → 企业层落锤」">
        </outline>
      </outline>
    </outline>
    <outline text="四、Phase 2 · Hermes 与知识治理（原「迭代二」，约 3~4 周）">
      <outline text="Hermes 三段式架构">
        <outline text="触发层（何时做）">
          <outline text="事件触发：新消息增量（订阅现有机制）">
          </outline>
          <outline text="定时触发：挂入行动引擎每日 08:00 扫描">
          </outline>
          <outline text="人工触发：页面提问 / 一键处理">
          </outline>
        </outline>
        <outline text="工具层（能做什么）">
          <outline text="读：查客户 / 查聊天（走 chatService）/ 查知识 / 查阶段历史">
          </outline>
          <outline text="写：建待办 / 打标签 / 提知识提案 / 生成草稿">
          </outline>
          <outline text="写操作约束（新）：不直接写库，一律走 Tool Gateway → 业务服务层（Phase 3 复用同一闸门）">
          </outline>
        </outline>
        <outline text="判断层（理解与表达）：LLM 走 aiApiClient，只做理解 + 生成">
        </outline>
        <outline text="人（落锤）：高风险操作确认队列">
        </outline>
      </outline>
      <outline text="权限二维模型（改：三级风险 × RBAC 合流）">
        <outline text="链路：User → RBAC 角色 → 数据范围 ACL → Tool Permission → Risk Level → 执行 / 审批">
        </outline>
        <outline text="🟢 只读：自由调用">
        </outline>
        <outline text="🟡 低风险写：可自动执行 + 全量审计日志">
        </outline>
        <outline text="🔴 高风险写（改阶段 / 移交 / 发布知识 / 对外发送）：必须人工确认">
        </outline>
        <outline text="分工：RBAC 判断「有没有权限」，风险分级判断「要多重确认」，ACL 判断「能不能看这条数据」">
        </outline>
      </outline>
      <outline text="知识治理升级（保留）">
        <outline text="治理字段：status / authority / version（版本链）/ TTL（保质期）">
        </outline>
        <outline text="published（已发布）过滤 + 审核 Tab">
        </outline>
        <outline text="反哺回路：聊天发现 → proposal → 人审 → 发布">
        </outline>
        <outline text="AI 无 publish 权限（账号级硬约束）">
        </outline>
        <outline text="效果回流：使用埋点 × 阶段结果归因（哪条话术在赚钱）">
        </outline>
        <outline text="TTL 主动巡检（到期问负责人「还成立吗」）">
        </outline>
      </outline>
      <outline text="认领 24h 后 AI 首次分类（原「新需求 · 功能二」，改）">
        <outline text="触发：认领满 24h 挂入每日扫描 + 手动立即初判按钮">
        </outline>
        <outline text="AI 输出：阶段初判 / 客户类型（经销商/终端）/ 意向评分 / 画像 12 字段（带证据链）">
        </outline>
        <outline text="字段溯源结构（新）：field_value / source / confidence / evidence / status（proposed → confirmed）/ updated_by / updated_at">
          <outline text="AI 产出 = proposed；销售确认或修正 = confirmed，全程留痕">
          </outline>
          <outline text="仅 stage / customer_type / intent_score 三个关键字段启用">
          </outline>
        </outline>
        <outline text="人可修正：销售可改，改动留痕（AI 提议、人落锤）">
        </outline>
        <outline text="上行 NAS 存档：结构化档案 JSON，聊天原文不上行（Phase 3 起转入 Postgres 表）">
        </outline>
        <outline text="权限：条目级 ACL——归属销售本人 + 主管/管理员可见">
        </outline>
      </outline>
    </outline>
    <outline text="五、Phase 3 · 企业事实层 + 多人（原「迭代四」+「多用户」章节合并）">
      <outline text="NAS 四层架构（新，展开见「七」）">
        <outline text="企业事实库 PostgreSQL：客户档案库落地，集中式 CRM 的胚胎">
        </outline>
        <outline text="企业知识库 WeKnora：只管知识检索，不做 CRM 主数据">
        </outline>
        <outline text="staging：AI proposal / 待审核知识">
        </outline>
        <outline text="backup：加密备份">
        </outline>
      </outline>
      <outline text="双向同步（改：原「单向上行」）">
        <outline text="上行（销售 → NAS）：成交登记 / 报价版本 / AI 客户档案 / 知识提案 / 审计事件">
        </outline>
        <outline text="下行（NAS → 销售）：客户归属 / 移交结果 / 锁定状态 / 企业标签 / 企业知识 / 主管修正 / 权限变化">
        </outline>
        <outline text="禁止：跨销售互写">
        </outline>
        <outline text="通道：local_outbox → Sync Service → Change Feed → 各 WeFlow">
        </outline>
        <outline text="仍不上行：原始聊天记录（默认）/ 未审核草稿与 proposal">
        </outline>
      </outline>
      <outline text="WeKnora 部署（原「迭代四」保留）">
        <outline text="本机 → NAS，Docker 5 核心容器">
        </outline>
        <outline text="staging / published 双库物理隔离">
        </outline>
        <outline text="模型配置：DeepSeek + bge-m3 向量 + bge-reranker 重排">
        </outline>
        <outline text="Hermes 经 MCP 接入企业知识库">
        </outline>
        <outline text="100 条评测集验收（答案正确率 ≥85% / 过期命中 = 0 / 越权 = 0）">
        </outline>
        <outline text="接口策略（改）：内置工具层与未来 API/MCP 同源，统一走 Tool Gateway">
        </outline>
      </outline>
      <outline text="多人三大问题">
        <outline text="撞单仲裁（改：提前到分配 / 认领阶段）">
          <outline text="手机号 → customer_identity 唯一 → owner 仲裁">
          </outline>
          <outline text="成交登记上行仍按手机号去重，同人跟进触发主管仲裁">
          </outline>
        </outline>
        <outline text="离职交接升级">
          <outline text="流程：申请移交 → 主管批准 → NAS 落锤 owner → 同步 → A 失权 / B 获得">
          </outline>
          <outline text="移交记录上行留痕，新设备恢复归属，证据链不断">
          </outline>
        </outline>
        <outline text="并发修改（新）">
          <outline text="version / updated_by / updated_at，乐观锁防止互相覆盖">
          </outline>
        </outline>
      </outline>
      <outline text="Hermes 企业化（新）">
        <outline text="原则：Hermes 不直接 UPDATE PostgreSQL">
        </outline>
        <outline text="路径：Tool Gateway → Permission → Policy → Business Service → PostgreSQL">
        </outline>
        <outline text="示例：request_transfer → 权限检查 → Risk=HIGH → 审批队列 → 主管确认 → CustomerService.transfer() → audit → 同步两端">
        </outline>
      </outline>
      <outline text="RBAC 权限矩阵">
        <outline text="销售：本人客户全部 / 读 published 知识 / 不可见成本价 / 可提 proposal">
        </outline>
        <outline text="销售主管：团队只读（阶段与成交，不看聊天原文）/ 审核发布 / 移交审批 / 可见成本">
        </outline>
        <outline text="管理员：归属管理 / 账号角色 / 密钥 / 全部知识库">
        </outline>
        <outline text="第四角色（新，待定义）：建议为系统 / AI 服务账号（只经 Gateway 调用，无人工登录）">
        </outline>
        <outline text="落地：WeKnora workspace 隔离 + 四角色；敏感知识单独建库 + 网关层条目级 ACL">
        </outline>
      </outline>
    </outline>
    <outline text="六、Phase 4 · 经营深化（原「迭代三」全部后移，约 3 周）">
      <outline text="目标管理（目标 vs 达成）">
      </outline>
      <outline text="售后工单（维修 / 保养 / 配件）+ 复购信号">
      </outline>
      <outline text="沉默客户前兆预警（沉默前三轮对话模式）">
      </outline>
      <outline text="竞对情报自动建档">
      </outline>
      <outline text="知识缺口清单（答不上来的反哺产品部门）">
      </outline>
      <outline text="客户公海（超期未跟进自动标红回收）">
      </outline>
      <outline text="知识运营看板（待审积压 / 知识新鲜度）">
      </outline>
      <outline text="多渠道线索录入（名片 / 展会 / 介绍）（改：并入 lead → customer_identity 模型）">
      </outline>
    </outline>
    <outline text="七、NAS 四层架构（新）">
      <outline text="① 企业事实库">
        <outline text="客户档案 / 成交记录 / 报价版本 / 归属 / 审计">
        </outline>
        <outline text="承载：PostgreSQL">
        </outline>
      </outline>
      <outline text="② 企业知识库">
        <outline text="产品 / FAQ / 话术 / SOP / 竞品">
        </outline>
        <outline text="承载：WeKnora（知识检索）">
        </outline>
      </outline>
      <outline text="③ staging">
        <outline text="AI proposal / 待审核知识">
        </outline>
      </outline>
      <outline text="④ backup">
        <outline text="加密备份">
        </outline>
      </outline>
      <outline text="边界：WeKnora 不变成 CRM 数据库，业务事实只在 PostgreSQL">
      </outline>
    </outline>
    <outline text="八、核心原则（保留 + 落字段）">
      <outline text="规则负责「什么时候该行动」">
      </outline>
      <outline text="Hermes 负责「行动时带什么知识」">
      </outline>
      <outline text="效果回流负责「下次行动更聪明」">
      </outline>
      <outline text="知识是服务，不是文件">
      </outline>
      <outline text="先审后发（Review-before-Publish）">
      </outline>
      <outline text="AI 可提议一切，落锤权在人（改：落到字段 status = proposed → confirmed）">
      </outline>
      <outline text="底座可替换，治理逻辑是自己的资产">
      </outline>
      <outline text="护城河 = 微信聊天数据 × 业务结果的配对">
      </outline>
    </outline>
    <outline text="九、修订标记说明（微调后可删除此分支）">
      <outline text="（新）= 相对原版新增的分支">
      </outline>
      <outline text="（改）= 相对原版修改过的内容">
      </outline>
      <outline text="无标记 = 原样保留">
      </outline>
      <outline text="主要变化：原迭代三后移为 Phase 4；原迭代四与「多用户」合并为 Phase 3；原「新需求」功能一并入 Phase 1、功能二并入 Phase 2；单向上行升级为双向同步">
      </outline>
    </outline>
  </body>
</opml>