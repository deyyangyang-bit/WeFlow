# WeFlow Central —— 原生 Windows Caddy 部署参数示例（非敏感）
#
# 用法：复制为 F:\WeFlow-Test\config\native.env 并逐项确认。
# 该真实文件由 scripts\install-native-caddy.ps1 生成/读取，不进 Git、不进交付包。
#
# 全部变量都是必填：缺失、空值、0.0.0.0、::、0.0.0.0/0 或非法 CIDR
# 一律让守卫脚本非零失败，不静默兜底。

# 监听绑定的物理 IPv4。必须是本机实际持有的地址，不能是通配地址。
# 当前测试机为 DHCP 动态地址，换网后会变，验收前必须重新确认。
WEFLOW_NATIVE_BIND_IP=192.168.1.57

# 只允许直连来源落入该网段，其余返回 403。
WEFLOW_NATIVE_ALLOWED_CIDR=192.168.1.0/24

# 测试域名（内部 CA 签发，不解析到公网）。
WEFLOW_NATIVE_HOSTNAME=weflow-central.test

# 全部程序、配置、日志、PKI 都在 F 盘固定前缀下。
WEFLOW_NATIVE_ROOT=F:\WeFlow-Test
WEFLOW_NATIVE_CONFIG_DIR=F:\WeFlow-Test\config
WEFLOW_NATIVE_LOG_DIR=F:\WeFlow-Test\logs
WEFLOW_NATIVE_PKI_DIR=F:\WeFlow-Test\pki

# 原生程序与运行文件。
WEFLOW_NATIVE_BIN_DIR=F:\WeFlow-Test\bin
WEFLOW_NATIVE_CADDY_EXE=F:\WeFlow-Test\bin\caddy.exe
WEFLOW_NATIVE_CADDYFILE=F:\WeFlow-Test\config\Caddyfile
WEFLOW_NATIVE_STATE_DIR=F:\WeFlow-Test\state

# 上游：Central 在宿主回环上的诊断端口，不对外开放。
WEFLOW_NATIVE_UPSTREAM=127.0.0.1:8787
